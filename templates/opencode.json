{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["@acramsay/opencode-models-md"],
  "compaction": {
    "buffer": "5%"
  },
  "agents": {
    "title": {
      "model": "openai/gpt-6-luna"
    },
    "compaction": {
      "model": "openai/gpt-6-luna"
    },
    "summary": {
      "model": "openai/gpt-6-luna"
    },
    "general": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "explore": {
      "model": "opencode/deepseek-v4.1-flash-free"
    }
  },
  "providers": {
    "openai": {
      "settings": {
        "baseURL": "https://api.openlux.ai/v1",
        "apiKey": "sbx-cs-openlux"
      },
      "env": []
    },
    "anthropic": {
      "settings": {
        "baseURL": "https://api.openlux.ai/v1",
        "apiKey": "sbx-cs-openlux"
      },
      "env": []
    },
    "google": {
      "settings": {
        "baseURL": "https://api.openlux.ai/v1beta",
        "apiKey": "sbx-cs-openlux"
      },
      "env": []
    },
    "deepseek": {
      "settings": {
        "apiKey": "sbx-cs-deepseek"
      },
      "env": []
    },
    "vti": {
      "name": "VTI",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://vps.town/connector/ai/v1",
        "apiKey": "sbx-cs-vti"
      },
      "env": [],
      "models": {
        "claude-fable-5-2": {},
        "claude-opus-5-5": {},
        "claude-sonnet-5-5": {},
        "claude-haiku-5-5": {},
        "claude-opus-4-6": {},
        "gemini-4-neon": {},
        "gemini-4-hydrogen": {},
        "gpt-6-luna": {}
      }
    }
  }
}
